<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_class_list" model="ir.ui.view">
        <field name="name">school.class.list</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <list string="Daftar Kelas">
                <field name="name"/>
                <field name="teacher_id"/>
            </list>
        </field>
    </record>

    <record id="view_school_class_form" model="ir.ui.view">
        <field name="name">school.class.form</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <form string="Formulir Kelas">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="teacher_id" options="{'no_create': True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_class" model="ir.actions.act_window">
        <field name="name">Data Kelas</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_school_class_action" name="Kelas" parent="menu_school_academic" action="action_school_class" sequence="10"/>
</odoo>